# --- Email OTP delivery (pick one and wire it up in app/api/auth/send-otp/route.ts) ---
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM="Roudhatul Quran <no-reply@yourdomain.com>"

# --- Google Drive video integration ---
# Use a public/shared Drive folder, or a service account for private folders.
# GOOGLE_DRIVE_API_KEY=
# GOOGLE_DRIVE_FOLDER_ID=

# --- Google Meet / Calendar (for auto-generating sessions instead of manual mock data) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Session/DB store for OTP + auth (replace the demo in-memory store) ---
# DATABASE_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- AI chatbot widget ---
# Get this from console.anthropic.com/settings/keys (a separate developer
# account from claude.ai — a Claude subscription does NOT include API access).
# ANTHROPIC_API_KEY=
